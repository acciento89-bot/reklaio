NODE_ENV=development
BASE_URL=http://localhost:3000
DATABASE_URL=postgresql://reklaio:CHANGE_ME@localhost:5432/reklaio
SESSION_SECRET=CHANGE_ME_TO_AT_LEAST_32_RANDOM_CHARACTERS
ADMIN_EMAILS=owner@example.com
UPLOAD_DIR=./uploads

SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=CHANGE_ME
SMTP_PASSWORD=CHANGE_ME
MAIL_FROM=Reklaio <noreply@reklaio.de>
CONTACT_RECIPIENT=reklaio@kamilunavo.com
CRON_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_SECRET
REMINDER_INTERVAL_MS=3600000

# KI-Funktionen. Der Prompt liegt im Reklaio-Code; im OpenAI-Dashboard
# muss kein zusätzlicher Prompt angelegt werden.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
PRO_AI_DOCUMENTS_MONTHLY=20
PRO_AI_LETTERS_MONTHLY=40

# Reklaio Pro über Stripe. Ohne vollständige Werte bleibt der Checkout deaktiviert.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO_MONTHLY=
REKLAIO_PRO_PRICE_LABEL=9,99 € pro Monat
REKLAIO_PRO_INTERVAL_LABEL=monatlich, automatisch verlängernd
REKLAIO_TAX_LABEL=Gesamtpreis inklusive aller anwendbaren Steuern

# Automatische Backups.
BACKUP_INTERVAL_SECONDS=86400
BACKUP_RETENTION_DAYS=14
BACKUP_POLL_SECONDS=300

# Rechtliche Anbieterangaben.
LEGAL_BUSINESS_NAME=Kamilunavo
LEGAL_OPERATOR_NAME=Piotr Kaminski
LEGAL_STREET=Otto-Braun-Straße 14
LEGAL_POSTAL_CITY=40595 Düsseldorf
LEGAL_COUNTRY=Deutschland
LEGAL_EMAIL=reklaio@kamilunavo.com
LEGAL_PHONE=
LEGAL_VAT_ID=
LEGAL_REGISTER_NAME=
LEGAL_REGISTER_NUMBER=
LEGAL_HOSTING_PROVIDER=Hetzner Online GmbH
LEGAL_HOSTING_COUNTRY=Deutschland
