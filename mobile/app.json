{
  "expo": {
    "name": "Reklaio",
    "slug": "reklaio",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "reklaio",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "de.kamilunavo.reklaio",
      "buildNumber": "1"
    },
    "android": {
      "package": "de.kamilunavo.reklaio",
      "versionCode": 1,
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      "expo-router",
      "expo-document-picker",
      "expo-notifications",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Erlaube Reklaio, Face ID zum Schutz deiner persönlichen Fallakten zu verwenden."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Erlaube Reklaio den Zugriff auf Fotos, damit du Belege zu deiner Fallakte hinzufügen kannst.",
          "cameraPermission": "Erlaube Reklaio den Zugriff auf die Kamera, damit du Belege direkt fotografieren kannst.",
          "microphonePermission": false
        }
      ],
      [
        "expo-secure-store",
        {
          "configureAndroidBackup": true,
          "faceIDPermission": "Erlaube Reklaio, Face ID zum Schutz deiner Fallakte zu verwenden."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": false
    },
    "extra": {
      "apiUrl": "https://reklaio.de"
    }
  }
}
